# Copy to .env.local (git-ignored) and fill in. Names only here; never commit real values.

# Supabase project URL.
VITE_SUPABASE_URL=

# Supabase publishable (anon) key. Safe for the browser; row-level security protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the processor (the Railway service, or http://localhost:8000 in development).
VITE_PROCESSOR_URL=

# 1 = run on in-memory fakes (no Supabase, no processor); 0 or unset = use the real services.
VITE_USE_FAKES=1

# With VITE_USE_FAKES=1: demo = the five pieces of the Library board, signed in with the terms accepted;
# anything else (or unset) = an empty library, signed out.
VITE_FAKE_SEED=

# Local mode: the URL of the local run server (see README), e.g. http://127.0.0.1:8765. The Library, editor and
# Practice then open the run folders made by run_piece.py, and every map save in the editor is written back to the
# folder (map.confirmed.json). Wins over VITE_USE_FAKES. Unset = off.
VITE_LOCAL_RUN=
