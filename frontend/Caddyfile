{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		# The landing page links out, and its address can hold ?next=/join/<token> (M-3).
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
	}

	# www.<domain> sends the visitor to the bare domain, same path and query (Decisions 2026-11-08). No domain is named,
	# so this file serves Prod, dev and any copy alike; an address without www never matches.
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	# A request whose path is a file that exists under the root.
	@found file

	# Built files have a hash in their name. A missing one is a plain 404, never the app's page, and never
	# marked as cacheable: only a file that exists gets the long cache.
	handle /assets/* {
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the app, so /join/<token> opened or returned to from Google works.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
