# Copy to .env (git-ignored) and fill in. Code and spikes load it; tests never need it.

# Supabase project URL.
SUPABASE_URL=

# Server-side Supabase key for writing rows and files. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Legacy HS256 secret that verifies user JWTs; leave empty on projects that use asymmetric signing keys.
SUPABASE_JWT_SECRET=

# JWKS URL for ES256/RS256 user JWTs; optional, derived from SUPABASE_URL when empty.
SUPABASE_JWKS_URL=

# Anthropic API key for the vision structure read (also used by the spikes).
ANTHROPIC_API_KEY=

# Allowed browser origins for CORS, comma-separated.
ALLOWED_ORIGINS=

# Set to true to run on the in-memory fakes (no Supabase, no network); empty means false.
USE_FAKES=
